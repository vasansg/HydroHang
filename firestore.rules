rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userFamilyCode(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.familyCode;
    }

    // Same household: used so one member can write in-app notifications into others' `/notifications`.
    function sameAuthenticatedFamily(actorUid, ownerUid) {
      return userFamilyCode(actorUid) != null
        && userFamilyCode(actorUid) == userFamilyCode(ownerUid);
    }

    match /users/{userId} {
      // Allow read for any authenticated user.
      // Needed for family code lookup during registration.
      // WARNING: This allows any user to read any other user's profile data.
      allow read: if request.auth != null;

      // Allow a user to create and update their own document.
      allow write: if request.auth != null && request.auth.uid == userId;

      // Subcollections do NOT inherit parent rules — `/notifications` must be declared explicitly.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && (
          request.auth.uid == userId
          || sameAuthenticatedFamily(request.auth.uid, userId)
        );
      }
    }

    match /laundry_schedules/{scheduleId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyCode == resource.data.familyCode;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyCode == request.resource.data.familyCode;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /washing_machines/{machineId} {
      // Any authenticated family member can read machines in their family
      allow read: if request.auth != null;
      // Only authenticated users can create/update machines (primary user managed on app side)
      allow create, update, delete: if request.auth != null;
    }

    match /dryers/{dryerId} {
      // Any authenticated family member can read dryers in their family
      allow read: if request.auth != null;
      // Only authenticated users can create/update/delete dryers (primary user managed on app side)
      allow create, update, delete: if request.auth != null;
    }

    match /washing_queue/{queueId} {
      // Any authenticated user can read queue entries
      allow read: if request.auth != null;
      // Any authenticated user can create a queue entry (familyCode validated client-side)
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Users can update/delete their own queue entries; family members can update status
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }
    }

    match /dryer_queue/{queueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }
    }

    match /gamification/{docId} {
      // Users can read their own gamification data; family members can read each other's
      allow read: if request.auth != null;
      // Only the owning user (or server) can write gamification data
      allow write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Family-level settings (module permissions). Keyed by familyCode.
    match /families/{familyCode} {
      // Any authenticated family member can read their family settings.
      allow read: if request.auth != null
        && userFamilyCode(request.auth.uid) == familyCode;
      // Only Primary role members can write family settings.
      allow write: if request.auth != null
        && userFamilyCode(request.auth.uid) == familyCode
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Primary';
    }
  }
}
