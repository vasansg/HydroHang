rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userFamilyCode(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.familyCode;
    }

    function isPrimaryUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == 'Primary';
    }

    // Same household: used so one member can write in-app notifications into others' `/notifications`.
    function sameAuthenticatedFamily(actorUid, ownerUid) {
      return userFamilyCode(actorUid) != null
        && userFamilyCode(actorUid) == userFamilyCode(ownerUid);
    }

    match /users/{userId} {
      // Allow read for any authenticated user.
      // Needed for family code lookup during registration.
      allow read: if request.auth != null;

      // A user can create and delete their own document.
      allow create, delete: if request.auth != null && request.auth.uid == userId;

      // Update rules — split to allow Primary to manage secondary members.
      allow update: if request.auth != null && (
        // Users can always update their own document.
        request.auth.uid == userId
        ||
        // Primary can update modulePermissions / isActive / familyCode
        // on same-family Secondary members only (aligns with Flutter rules).
        (
          isPrimaryUser(request.auth.uid)
          && sameAuthenticatedFamily(request.auth.uid, userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.role != 'Primary'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['modulePermissions', 'isActive', 'familyCode'])
        )
      );

      // Subcollections do NOT inherit parent rules.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && (
          request.auth.uid == userId
          || sameAuthenticatedFamily(request.auth.uid, userId)
        );
      }
    }

    match /laundry_schedules/{scheduleId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyCode == resource.data.familyCode;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyCode == request.resource.data.familyCode;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /washing_machines/{machineId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /dryers/{dryerId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /washing_queue/{queueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }
    }

    match /dryer_queue/{queueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }
    }

    match /gamification/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Family-level document (kept for any future family-wide settings).
    match /families/{familyCode} {
      allow read: if request.auth != null
        && userFamilyCode(request.auth.uid) == familyCode;
      allow write: if request.auth != null
        && userFamilyCode(request.auth.uid) == familyCode
        && isPrimaryUser(request.auth.uid);

      // Per-user module permissions subcollection (legacy — now stored on users/{uid}).
      match /memberPermissions/{userId} {
        allow read: if request.auth != null
          && userFamilyCode(request.auth.uid) == familyCode
          && (request.auth.uid == userId || isPrimaryUser(request.auth.uid));
        allow write: if request.auth != null
          && userFamilyCode(request.auth.uid) == familyCode
          && isPrimaryUser(request.auth.uid);
      }
    }
  }
}
